{
    "name": "@project/lib",
    "version": "1.0.0",
    "private": true,
    "main": "index.js",
    "types": "index.d.ts",
    "type": "module",
    "exports": {
        ".": "./dist/index.js",
        "./models": "./dist/models/index.js",
        "./search": "./dist/search/index.js",
        "./repositories": "./dist/steam/repositories/index.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build:wasm": "asc --config asconfig.json --target release --bindings esm",
        "build:ts": "tsc -b .",
        "build:python": "node ../../python/xgboost_model/run-training.js",
        "build": "npm run build:python && npm run build:wasm && npm run build:ts",
        "watch:wasm": "watch \"npm run build:wasm\" src/assembly",
        "watch:ts": "tsc -b . --watch",
        "watch:python": "watch \"npm run build:python\" ../../python/xgboost_model/input",
        "dev": "npm-run-all --parallel watch:*",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "db:migration": "drizzle-kit generate",
        "lint": "tsc --noEmit --skipLibCheck --pretty",
        "test": "tsx --test **/*.spec.ts tsx"
    },
    "devDependencies": {
        "assemblyscript": "^0.28.2",
        "drizzle-kit": "^0.30.6",
        "drizzle-orm": "^0.41.0",
        "htmlrewriter": "^0.0.12",
        "npm-run-all": "^4.1.5",
        "tsx": "^4.19.4",
        "typescript": "^5.8.3",
        "watch": "^1.0.2"
    },
    "dependencies": {
        "date-fns": "^4.1.0"
    }
}
