{
    "compilerOptions": {
        "moduleResolution": "bundler",
        "noUncheckedIndexedAccess": true,
        "target": "ESNext",
        "module": "ESNext",
        "paths": {
            "@models": [
                "./models"
            ],
            "@models/*": [
                "./models/*"
            ],
            "@config": [
                "./config"
            ],
            "@config/*": [
                "./config/*"
            ]
        },
        "lib": [
            "ESNext",
            "DOM"
        ],
    }
}