{
	"name": "rarest-achievement",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"packages/lib",
		"packages/site",
		"packages/worker"
	],
	"scripts": {
		"dev": "npm-run-all --parallel dev:*",
		"dev:lib": "npm run dev -w @project/lib",
		"dev:site": "npm run dev -w @project/site",
		"dev:worker": "echo \"Skipping worker\"",
		"test": "npm run test --workspaces",
		"format:check": "biome ci .",
		"check": "biome ci . && npm run check --workspaces --if-present",
		"format": "biome format --write && biome check --write --linter-enabled false",
		"db:push": "npm run db:push --workspaces",
		"db:migrate": "npm run db:migrate --workspaces",
		"db:migration": "npm run db:migration --workspace=@project/lib",
		"prepare": "node python/xgboost_model/setup-venv.js"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@cloudflare/workers-types": "4.20260529.1",
		"@modelcontextprotocol/sdk": "^1.20.2",
		"@types/better-sqlite3": "^7.6.13",
		"better-sqlite3": "^12.2.0",
		"effect": "^3.21.4",
		"npm-run-all": "^4.1.5",
		"zod": "^3.25.76"
	},
	"overrides": {
		"esm-env": "npm:esm-env-runtime@^0.1.1",
		"wrangler": "^4.95.0"
	},
	"type": "module"
}
