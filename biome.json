{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"files": {
		"ignore": ["**/worker-configuration.d.ts"]
	},
	"vcs": {
		"useIgnoreFile": true
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineEnding": "lf",
		"ignore": ["**/*.svelte", "**/*.css", "**/*.html"],
		"lineWidth": 120
	},
	"linter": {
		"rules": {
			"complexity": {
				"noStaticOnlyClass": "off"
			}
		}
	},
	"overrides": [
		{
			"include": ["**/*.svelte"],
			"linter": { "rules": { "style": { "useConst": "off", "useImportType": "off" } } }
		}
	]
}
