{
    "name": "rarest-achievement",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "packages/lib",
        "packages/site",
        "packages/worker"
    ],
    "scripts": {
        "dev": "npm-run-all --parallel dev:*",
        "dev:lib": "npm run dev -w @project/lib",
        "dev:site": "npm run dev -w @project/site",
        "dev:worker": "echo \"Skipping worker\"",
        "test": "npm run test --workspaces",
        "check": "biome lint ./packages/* && npm run check --workspaces --if-present",
        "format": "prettier --log-level silent --write ./packages/*/src && biome check ./packages/* --fix --unsafe",
        "db:push": "npm run db:push --workspaces",
        "db:migrate": "npm run db:migrate --workspaces",
        "db:migration": "npm run db:migration --workspace=@project/lib",
        "prepare": "node python/xgboost_model/setup-venv.js",
        "postinstall": "patch-package || echo 'No patches to apply'"
    },
    "dependencies": {
        "drizzle-orm": "0.42.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.4",
        "@cloudflare/workers-types": "^4.20250613.0",
        "@types/better-sqlite3": "^7.6.13",
        "better-sqlite3": "^12.2.0",
        "npm-run-all": "^4.1.5",
        "patch-package": "^8.0.0"
    },
    "overrides": {
        "drizzle-orm": "0.42.0",
        "esm-env": "npm:esm-env-runtime@^0.1.1",
        "wrangler": "^4.7.2"
    },
    "type": "module"
}
