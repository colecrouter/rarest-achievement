{
	"name": "@project/lib",
	"version": "1.0.0",
	"private": true,
	"main": "index.js",
	"types": "index.d.ts",
	"type": "module",
	"exports": {
		".": "./src/index.js",
		"./models": "./src/models/index.js",
		"./search": "./src/search/index.js",
		"./repositories": "./src/steam/repositories/index.js",
		"./test": "./test/e2e/index.js"
	},
	"scripts": {
		"check": "tsc --noEmit --skipLibCheck --pretty",
		"build:python": "node ../../python/xgboost_model/run-training.js",
		"build": "npm run build:python",
		"watch:python": "watch \"npm run build:python\" ../../python/xgboost_model/input",
		"dev": "npm-run-all --parallel watch:*",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:migration": "drizzle-kit generate",
		"test": "tsx --import ./test/setup.js --test \"**/*.spec.ts\""
	},
	"devDependencies": {
		"drizzle-kit": "^0.18.1",
		"drizzle-orm": "0.45.2",
		"htmlrewriter": "^0.0.12",
		"node-resolve-ts": "^1.0.2",
		"npm-run-all": "^4.1.5",
		"tsx": "^4.19.4",
		"typescript": "^5.8.3",
		"watch": "^0.13.0"
	},
	"peerDependencies": {
		"drizzle-orm": "0.45.2"
	},
	"dependencies": {
		"@cloudflare/vitest-pool-workers": "0.14.5",
		"@inlang/paraglide-js": "2.15.3",
		"@sentry/sveltekit": "8.55.1",
		"@sveltejs/adapter-cloudflare": "^0.0.1",
		"@sveltejs/kit": "^2.57.1",
		"date-fns": "^4.1.0"
	}
}
