{
    "compilerOptions": {
        "moduleResolution": "bundler",
        "noUncheckedIndexedAccess": true,
        "target": "ESNext",
        "module": "ESNext",
        "strict": true,
        "paths": {
            "@models": [
                "./models"
            ],
            "@models/*": [
                "./models/*"
            ],
            "@config": [
                "./config"
            ],
            "@config/*": [
                "./config/*"
            ]
        },
        "lib": [
            "ESNext",
            "DOM"
        ],
        "types": [
            "@cloudflare/workers-types",
        ]
    }
}