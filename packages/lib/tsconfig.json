{
    "compilerOptions": {
        "baseUrl": "src",
        "allowJs": true,
        "checkJs": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "moduleResolution": "bundler",
        "noUncheckedIndexedAccess": true,
        "target": "ESNext",
        "module": "ESNext",
        "paths": {
            "@models": [
                "./models"
            ],
            "@models/*": [
                "./models/*"
            ],
            "@config": [
                "./config"
            ],
            "@config/*": [
                "./config/*"
            ]
        },
        "outDir": "dist",
        "rootDir": "src",
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.js"
    ],
    "exclude": [
        "dist",
        "src/assembly",
    ]
}